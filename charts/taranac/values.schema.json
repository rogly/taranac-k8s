{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "config": {
      "type": "object",
      "required": ["domain"],
      "properties": {
        "domain": {"type": "string", "minLength": 1},
        "timezone": {"type": "string"}
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "combined": {"type": "boolean"},
        "tcp": {"$ref": "#/definitions/service"},
        "udp": {"$ref": "#/definitions/service"}
      }
    },
    "networkPolicy": {"type": "object", "properties": {"enabled": {"type": "boolean"}}},
    "keel": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "policy": {"type": "string"},
        "trigger": {"enum": ["poll", "push"]},
        "approvals": {"type": "integer", "minimum": 0},
        "images": {"type": "array"}
      }
    },
    "persistence": {
      "type": "object",
      "properties": {
        "state": {
          "type": "object",
          "properties": {
            "accessModes": {"type": "array", "minItems": 1, "items": {"type": "string"}}
          }
        }
      }
    },
    "postgresql": {"type": "object", "properties": {"enabled": {"type": "boolean"}}},
    "externalDatabase": {"type": "object"}
  },
  "definitions": {
    "service": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "type": {"enum": ["LoadBalancer", "NodePort", "ClusterIP"]},
        "externalTrafficPolicy": {"enum": ["", "Cluster", "Local"]},
        "ports": {"type": "object"}
      }
    }
  }
}
